{
  "name": "shopport-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @shopport/mobile export",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "codegen": "pnpm --filter @shopport/mobile codegen",
    "doctor": "pnpm --filter @shopport/mobile run doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start": "pnpm --filter @shopport/mobile start",
    "storybook": "pnpm --filter @shopport/mobile run storybook:start",
    "test": "pnpm --filter @shopport/mobile test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@shopport/eslint-config": "workspace:*",
    "@shopport/prettier-config": "workspace:*",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
