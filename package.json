{
  "name": "shopport-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @shopport/mobile export",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "codegen": "pnpm --filter @shopport/mobile codegen",
    "doctor": "pnpm --filter @shopport/mobile run doctor",
    "format": "pnpm --filter @shopport/mobile format",
    "format:check": "pnpm --filter @shopport/mobile format:check",
    "lint": "pnpm --filter @shopport/mobile lint",
    "start": "pnpm --filter @shopport/mobile start",
    "storybook": "pnpm --filter @shopport/mobile run storybook:start",
    "test": "pnpm --filter @shopport/mobile test && node --test scripts/audit-policy.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
