{
  "name": "@shopport/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "doctor": "expo-doctor",
    "export": "expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android",
    "start": "expo start --dev-client",
    "storybook:start": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client",
    "storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --ios",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPatterns=integration",
    "test:storybook": "jest --runInBand --testPathPatterns=storybook",
    "test:unit": "jest --runInBand --testPathPatterns=unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "4.2.11",
    "@expo/ui": "~57.0.11",
    "@react-native-community/netinfo": "12.0.1",
