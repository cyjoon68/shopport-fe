{
  "name": "@shopport/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "doctor": "node scripts/with-env.mjs expo-doctor",
    "export": "node scripts/with-env.mjs expo export --platform ios --output-dir dist/ios && node scripts/with-env.mjs expo export --platform android --output-dir dist/android",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start": "node scripts/with-env.mjs expo start --dev-client",
    "ios": "node scripts/with-env.mjs expo run:ios",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:integration": "jest --runInBand --testPathPatterns=integration",
    "test:unit": "jest --runInBand --testPathPatterns=unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "4.2.11",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-kakao/core": "2.4.6",
    "@react-native-kakao/user": "2.4.6",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopport/tokens": "workspace:*",
    "@shopport/ui": "workspace:*",
    "@tanstack/ai": "0.44.0",
    "@tanstack/ai-client": "0.23.2",
    "@tanstack/ai-react": "0.19.2",
    "expo": "~57.0.17",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "graphql": "16.14.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-unistyles": "3.3.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@eslint/js": "9.39.2",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/client-preset": "6.1.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@shopport/typescript-config": "workspace:*",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.15",
    "@types/react": "~19.2.2",
    "babel-jest": "29.7.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "expo-doctor": "1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
