    "@react-native-kakao/user": "2.4.6",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopport/tokens": "workspace:*",
    "@shopport/ui": "workspace:*",
    "@tanstack/ai": "0.44.0",
    "@tanstack/ai-client": "0.23.2",
    "@tanstack/ai-react": "0.19.2",
    "expo": "~57.0.12",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
